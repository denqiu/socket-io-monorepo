{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Rules/Comments",
            "runtimeExecutable": "pnpm",
            "preLaunchTask": "Prelaunch Rules/Comments",
            "runtimeArgs": ["comments"],
            "internalConsoleOptions": "openOnSessionStart",
            "outFiles": [
                "${workspaceFolder}/packages/util-eslint/rules/build/**/*.js"
            ],
            "sourceMaps": true,
            "cwd": "${workspaceFolder}/packages/util-eslint/rules"
        }
    ]
}
